# Database Configuration
# Copy this file to application.properties and fill in your actual values
app.db.url=jdbc:postgresql://localhost:5432/your_database_name
app.db.user=your_username
app.db.password=your_password

# Groq AI Configuration (for response suggestions)
# Get your API key from: https://console.groq.com/keys
groq.api.key=your_groq_api_key_here
groq.api.url=https://api.groq.com/openai/v1/chat/completions
groq.model=llama-3.1-70b-versatile
groq.max.tokens=500
groq.temperature=0.7

# Google Perspective API Configuration (for content moderation)
# Get your API key from: https://developers.perspectiveapi.com/s/docs-get-started
perspective.api.key=your_perspective_api_key_here

# LibreTranslate Configuration (for translation)
# Public instance (free): https://libretranslate.com/translate
# Or self-host: https://github.com/LibreTranslate/LibreTranslate
libretranslate.api.url=https://libretranslate.com/translate
libretranslate.api.key=
# API key is optional for public instance (leave empty)
# For self-hosted or premium, add your key here
