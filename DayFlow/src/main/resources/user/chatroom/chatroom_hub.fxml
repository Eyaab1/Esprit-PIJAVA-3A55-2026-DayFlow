<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" styleClass="chat-root" stylesheets="@chatroom_hub.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.chatroom.ChatroomHubController">

    <!-- ══════════════════════════════════════
         SIDEBAR (gauche)
         ══════════════════════════════════════ -->
    <left>
        <VBox minWidth="240" prefWidth="280" styleClass="chat-sidebar">

            <!-- Logo + titre -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-header">
                <StackPane maxHeight="36" maxWidth="36" minHeight="36" minWidth="36" styleClass="brand-badge">
                    <Label styleClass="brand-badge-text" text="DF" />
                </StackPane>
                <Label styleClass="sidebar-app-title" text="DayFlow Chat" />
            </HBox>

            <!-- Barre de recherche -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-search-wrap">
                <padding><Insets bottom="0" left="14" right="14" top="0" /></padding>
                <Label styleClass="icon-muted" text="🔍" />
                <TextField fx:id="searchField" promptText="Search..." styleClass="sidebar-search" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Feedback erreur recherche -->
            <Label fx:id="searchErrorLabel" text="" managed="false" visible="false" styleClass="field-error" />

            <!-- Label section -->
            <Label styleClass="chat-sidebar-title" text="RECENT CHATS" />

            <Label fx:id="emptyLabel" managed="false" styleClass="sidebar-empty-hint" text="Aucun salon — créez un objectif pour démarrer." visible="false" wrapText="true" VBox.vgrow="ALWAYS" />

            <!-- Liste des chats -->
            <ListView fx:id="chatListView" styleClass="chat-list" VBox.vgrow="ALWAYS" />

        </VBox>
    </left>

    <!-- ══════════════════════════════════════
         CHAT AREA (centre)
         ══════════════════════════════════════ -->
    <center>
        <VBox styleClass="chat-center" VBox.vgrow="ALWAYS">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="chat-header">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="headerTitleLabel" styleClass="chat-title" text="Design chat" />
                    <Label fx:id="headerSubLabel" styleClass="chat-sub" text="" />
                </VBox>
                <!-- Avatar groupe (initiales) -->
                <StackPane managed="false" maxHeight="40" maxWidth="40" minHeight="40" minWidth="40" styleClass="avatar header-avatar" visible="false">
                    <Label fx:id="headerAvatarLabel" styleClass="avatar-text" text="?" />
                </StackPane>
                <Region prefWidth="8" />
                <Button onAction="#onToggleSearch" text="🔍" styleClass="icon-btn" focusTraversable="false"/>
                <!-- Boutons admin (cachés par défaut) -->
                <Button fx:id="pendingBtn" managed="false" onAction="#onPendingRequests" styleClass="btn-pending" text="⏳ Demandes" visible="false" />
                <Button fx:id="lockBtn" managed="false" onAction="#onLock" styleClass="btn-admin btn-lock" text="🔒" visible="false" />
                <Button fx:id="archiveBtn" managed="false" onAction="#onArchive" styleClass="btn-admin btn-archive" text="📦" visible="false" />
                <Button fx:id="deleteBtn" managed="false" onAction="#onDeleteRoom" styleClass="btn-admin btn-delete" text="🗑" visible="false" />
            </HBox>

            <!-- Corps : messages (centre) + saisie (bas) -->
            <BorderPane styleClass="chat-center-body" VBox.vgrow="ALWAYS">
                <top>
                    <VBox>
                        <!-- Bannière message épinglé (style WhatsApp) -->
                        <VBox fx:id="pinnedBanner" visible="false" managed="false" styleClass="pinned-banner">
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="pinned-banner-row">
                                <Label text="📌" styleClass="pinned-icon"/>
                                <VBox spacing="1" HBox.hgrow="ALWAYS">
                                    <Label text="Message épinglé" styleClass="pinned-title"/>
                                    <Label fx:id="pinnedBannerText" text="" styleClass="pinned-text" maxWidth="400"/>
                                </VBox>
                                <Button text="✕" onAction="#onUnpinMessage" focusTraversable="false" styleClass="icon-btn icon-btn-sm"/>
                            </HBox>
                        </VBox>

                        <!-- Barre de recherche dans les messages -->
                        <HBox fx:id="searchMsgBar" alignment="CENTER_LEFT" spacing="8" visible="false" managed="false" styleClass="search-msg-bar">
                            <Label text="🔍" styleClass="search-msg-icon"/>
                            <TextField fx:id="msgSearchField" promptText="Rechercher dans les messages..."
                                       HBox.hgrow="ALWAYS" styleClass="search-msg-field"/>
                            <Label fx:id="searchResultLabel" text="" styleClass="search-msg-result"/>
                            <Button text="✕" onAction="#onCloseSearch" focusTraversable="false" styleClass="icon-btn icon-btn-sm"/>
                        </HBox>
                    </VBox>
                </top>
                <center>
                    <ScrollPane fx:id="messagesScroll" fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" pannable="false" styleClass="chat-messages" vbarPolicy="AS_NEEDED">
                        <content>
                            <VBox fx:id="messagesBox" fillWidth="true" spacing="10">
                                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </center>
                <bottom>
                    <VBox>
                        <!-- Zone traduction (indicateur + résultat) -->
                        <VBox fx:id="translationZone" visible="false" managed="false" styleClass="translation-zone">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="translationStatusLabel" text="🌐 Traduction en cours..." styleClass="translation-status"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="✕" onAction="#onCloseTranslation" focusTraversable="false" styleClass="icon-btn icon-btn-sm"/>
                            </HBox>
                            <Label fx:id="translationResultLabel" text="" wrapText="true" styleClass="translation-result"/>
                            <Label fx:id="translationOriginalLabel" text="" wrapText="true" styleClass="translation-original"/>
                        </VBox>

                        <!-- Barre d'input -->
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chat-input-row">
                            <Button text="📎" onAction="#onAttachMenu" focusTraversable="false" styleClass="icon-btn input-icon"/>
                            <TextField fx:id="messageField" editable="true" focusTraversable="true"
                                       promptText="Your message..." styleClass="chat-field" HBox.hgrow="ALWAYS" />
                            <Button text="😊" onAction="#onEmojiPicker" focusTraversable="false" styleClass="icon-btn input-icon"/>
                            <Button fx:id="recordBtn" text="🎤" onAction="#onToggleRecord" focusTraversable="false" styleClass="icon-btn input-icon"/>
                            <Button focusTraversable="false" onAction="#onSendMessage" styleClass="btn-send" text="➤" />
                        </HBox>
                    </VBox>
                </bottom>
            </BorderPane>

        </VBox>
    </center>

    <!-- ══════════════════════════════════════
         GROUP INFO (droite)
         ══════════════════════════════════════ -->
    <right>
        <VBox minWidth="240" prefWidth="280" styleClass="right-panel">

            <!-- Titre -->
            <HBox alignment="CENTER_LEFT" styleClass="right-panel-header">
                <Label styleClass="right-panel-title" text="Group Info" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="right-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="0">

                        <!-- Section Files -->
                        <Label styleClass="section-muted-title" text="Files" />

                        <!-- Photos -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="file-row">
                            <Label styleClass="file-row-icon" text="📷" />
                            <Label fx:id="photoCount" styleClass="file-row-label" text="— photos" HBox.hgrow="ALWAYS" />
                            <Label styleClass="file-row-count" text="∨" />
                        </HBox>

                        <!-- Videos -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="file-row">
                            <Label styleClass="file-row-icon" text="🎬" />
                            <Label fx:id="videoCount" styleClass="file-row-label" text="— videos" HBox.hgrow="ALWAYS" />
                            <Label styleClass="file-row-count" text="∨" />
                        </HBox>

                        <!-- Files -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="file-row">
                            <Label styleClass="file-row-icon" text="📁" />
                            <Label styleClass="file-row-label" text="Files" HBox.hgrow="ALWAYS" />
                            <Label styleClass="file-row-count" text="∨" />
                        </HBox>

                        <!-- Links -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="file-row">
                            <Label styleClass="file-row-icon" text="🔗" />
                            <Label styleClass="file-row-label" text="Shared links" HBox.hgrow="ALWAYS" />
                            <Label styleClass="file-row-count" text="∨" />
                        </HBox>

                        <!-- Section Members -->
                        <HBox alignment="CENTER_LEFT" styleClass="members-section-row">
                            <Label fx:id="memberCountLabel" styleClass="members-section-title" text="Members" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="📊" onAction="#onShowActivity" focusTraversable="false" styleClass="icon-btn icon-primary"/>
                        </HBox>

                        <ListView fx:id="membersListView" prefHeight="320" styleClass="members-list" />

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </right>

</BorderPane>
