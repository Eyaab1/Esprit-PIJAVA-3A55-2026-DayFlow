<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="controllers.account.ResetPasswordController" prefHeight="560.0" prefWidth="900.0" stylesheets="@../../styles/auth.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" spacing="14.0" styleClass="auth-card" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="60.0">
         <padding>
            <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
         </padding>
         <children>
            <Label styleClass="auth-title" text="Reset Password" />
            <Label styleClass="auth-subtitle" text="Paste your token, then set a new password." />
            <TextField fx:id="tokenField" promptText="Reset token" prefHeight="38.0" prefWidth="360.0" />
            <PasswordField fx:id="newPasswordField" promptText="New password" prefHeight="38.0" prefWidth="360.0" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" prefHeight="38.0" prefWidth="360.0" />
            <Button fx:id="resetButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="360.0" styleClass="primary-button" text="Reset password" />
            <Button fx:id="backButton" mnemonicParsing="false" prefHeight="38.0" prefWidth="360.0" styleClass="secondary-button" text="Back to login" />
         </children>
      </VBox>
   </children>
</AnchorPane>
