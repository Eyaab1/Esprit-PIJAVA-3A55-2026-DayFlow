<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="shellRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.account.ShellController"
            stylesheets="@shell.css">
   <top>
      <VBox spacing="0">
         <HBox fx:id="backBar" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="shell-back-bar">
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBack" styleClass="shell-back-button" text="← Retour" />
         </HBox>
         <VBox fx:id="navbarContainer" managed="false" visible="false">
            <children>
               <fx:include source="../../components/navbar/navbar.fxml" />
            </children>
         </VBox>
      </VBox>
   </top>
   <center>
      <VBox BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
