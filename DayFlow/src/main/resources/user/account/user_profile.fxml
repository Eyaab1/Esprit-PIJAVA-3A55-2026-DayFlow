<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.account.UserProfileController"
            styleClass="profile-root" stylesheets="@user_profile.css">
   <top>
      <HBox styleClass="profile-hero" alignment="CENTER_LEFT" spacing="20">
         <children>
            <Label fx:id="heroAvatarLabel" styleClass="profile-hero-avatar" alignment="CENTER" text="?" />
            <VBox spacing="4" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="heroNameLabel" styleClass="profile-hero-name" text=" " />
                  <Label fx:id="heroEmailLabel" styleClass="profile-hero-email" text=" " />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="28" left="32" right="32" top="28" />
         </padding>
      </HBox>
   </top>
   <left>
      <VBox spacing="16" styleClass="profile-sidebar">
         <children>
            <VBox spacing="10" styleClass="profile-side-card">
               <children>
                  <Label styleClass="profile-side-title" text="👤  Informations personnelles" />
                  <Label fx:id="sideEmailLabel" styleClass="profile-side-line" text="EMAIL —" />
                  <Label fx:id="sideAgeLabel" styleClass="profile-side-line" text="ÂGE —" />
                  <Label fx:id="sideMemberLabel" styleClass="profile-side-line" text="MEMBRE DEPUIS —" />
               </children>
               <padding>
                  <Insets bottom="16" left="16" right="16" top="16" />
               </padding>
            </VBox>
            <FlowPane hgap="10" vgap="10" prefWrapLength="260">
               <children>
                  <VBox styleClass="profile-stat-tile stat-pub" alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="statPublishedLabel" styleClass="profile-stat-value" text="0" />
                        <Label styleClass="profile-stat-caption" text="Publiés" />
                     </children>
                     <padding>
                        <Insets bottom="12" left="14" right="14" top="12" />
                     </padding>
                  </VBox>
                  <VBox styleClass="profile-stat-tile stat-saved" alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="statSavedLabel" styleClass="profile-stat-value" text="0" />
                        <Label styleClass="profile-stat-caption" text="Sauvegardés" />
                     </children>
                     <padding>
                        <Insets bottom="12" left="14" right="14" top="12" />
                     </padding>
                  </VBox>
                  <VBox styleClass="profile-stat-tile stat-draft" alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="statDraftsLabel" styleClass="profile-stat-value" text="0" />
                        <Label styleClass="profile-stat-caption" text="Brouillons" />
                     </children>
                     <padding>
                        <Insets bottom="12" left="14" right="14" top="12" />
                     </padding>
                  </VBox>
                  <VBox styleClass="profile-stat-tile stat-sched" alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="statScheduledLabel" styleClass="profile-stat-value" text="0" />
                        <Label styleClass="profile-stat-caption" text="Planifiés" />
                     </children>
                     <padding>
                        <Insets bottom="12" left="14" right="14" top="12" />
                     </padding>
                  </VBox>
               </children>
            </FlowPane>
         </children>
         <padding>
            <Insets bottom="24" left="20" right="16" top="8" />
         </padding>
      </VBox>
   </left>
   <center>
      <VBox spacing="14" styleClass="profile-main">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12">
               <children>
                  <Label styleClass="profile-activity-title" text="📓  Mes activités" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Hyperlink fx:id="openFeedLink" onAction="#onOpenFeed" styleClass="profile-feed-link" text="Voir le fil →" />
               </children>
            </HBox>
            <VBox spacing="8" styleClass="profile-tabs-wrap">
               <children>
                  <HBox spacing="8" alignment="CENTER_LEFT">
                     <children>
                        <ToggleButton fx:id="tabPosts" mnemonicParsing="false" styleClass="profile-tab" text="Mes posts (0)" />
                        <ToggleButton fx:id="tabSaved" mnemonicParsing="false" styleClass="profile-tab" text="Sauvegardés (0)" />
                        <ToggleButton fx:id="tabScheduled" mnemonicParsing="false" styleClass="profile-tab" text="Planifiés (0)" />
                        <ToggleButton fx:id="tabDrafts" mnemonicParsing="false" styleClass="profile-tab" text="Brouillons (0)" />
                     </children>
                  </HBox>
                  <HBox spacing="8" alignment="CENTER_LEFT">
                     <children>
                        <ToggleButton fx:id="tabChatrooms" mnemonicParsing="false" styleClass="profile-tab" text="Chatrooms (0)" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <ScrollPane fitToWidth="true" styleClass="profile-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="contentBox" spacing="12" styleClass="profile-content-inner" />
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="24" left="12" right="28" top="8" />
         </padding>
      </VBox>
   </center>
</BorderPane>
