<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.reclamation.MesReclamationsController"
      styleClass="reclam-root" stylesheets="@mes_reclamations.css">
   <children>
      <VBox styleClass="reclam-page-inner" VBox.vgrow="ALWAYS">
         <children>
            <VBox styleClass="reclam-main-card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="reclam-header">
                     <children>
                        <StackPane styleClass="reclam-header-icon-wrap">
                           <children>
                              <Label styleClass="reclam-header-emoji" text="💬" />
                           </children>
                        </StackPane>
                        <Label styleClass="reclam-title" text="Mes Réclamations" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="newReclamationBtn" mnemonicParsing="false" onAction="#onNouvelleReclamation" styleClass="btn-new-reclam" text="＋  Nouvelle réclamation" />
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" styleClass="reclam-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="listContainer" spacing="14.0" styleClass="reclam-list-inner">
                           <padding>
                              <Insets bottom="16.0" left="4.0" right="4.0" top="8.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
