<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.goals_routines.RoutineDetailsController">
   <content>
      <VBox spacing="25.0" styleClass="dashboard-root" stylesheets="@goals.css">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <children>
            <!-- Back Button -->
            <Button onAction="#onBackToGoal" styleClass="breadcrumb-button" text="← Retour aux objectifs">
               <padding>
                  <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
               </padding>
            </Button>
            
            <!-- Goal Header -->
            <VBox styleClass="goal-detail-header">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="goalTitleLabel" styleClass="goal-detail-title" text="Titre de l'objectif" />
                              <Label fx:id="goalDescriptionLabel" styleClass="goal-detail-subtitle" text="Description de l'objectif" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <Label fx:id="goalStatusBadge" styleClass="status-badge-active" text="ACTIVE" />
                        
                        <Button onAction="#onEditGoal" styleClass="secondary-button" text="✏️ Modifier">
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                           </padding>
                        </Button>
                        
                        <Button onAction="#onDeleteGoal" styleClass="delete-button" text="🗑️ Supprimer">
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
                  
                  <!-- Goal Progress and Dates -->
                  <HBox spacing="30.0">
                     <padding>
                        <Insets top="15.0" />
                     </padding>
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="detail-label" text="Progression" />
                              <Label fx:id="goalProgressLabel" styleClass="detail-value" text="0%" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="detail-label" text="Date de début" />
                              <Label fx:id="goalStartDateLabel" styleClass="detail-value" text="01/01/2026" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="detail-label" text="Date de fin" />
                              <Label fx:id="goalEndDateLabel" styleClass="detail-value" text="31/12/2026" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
               </padding>
            </VBox>
            
            <!-- Routines Section -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label styleClass="section-title" text="Routines" />
                  <Label fx:id="routineCountLabel" styleClass="section-count" text="(0)" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#onNewRoutine" styleClass="new-goal-button" text="➕ Nouvelle Routine">
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>
            
            <!-- Routines Grid -->
            <FlowPane fx:id="routinesContainer" hgap="20.0" vgap="20.0" styleClass="goals-grid" />
         </children>
      </VBox>
   </content>
</ScrollPane>
