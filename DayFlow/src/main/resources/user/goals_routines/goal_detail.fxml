<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="gd-root" stylesheets="@goal_detail.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.goals_routines.GoalDetailController">
   <content>
      <VBox spacing="0" styleClass="gd-inner">
         <children>
            <Hyperlink fx:id="backLink" styleClass="gd-back" text="← Retour aux objectifs" />

            <HBox alignment="TOP_LEFT" spacing="16" styleClass="gd-title-row">
               <children>
                  <VBox spacing="8" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                           <children>
                              <Label fx:id="goalTitleLabel" styleClass="gd-title" text="Titre" wrapText="true" />
                              <Label fx:id="statusBadge" styleClass="gd-badge-active" text="ACTIVE" />
                           </children>
                        </HBox>
                        <Label fx:id="goalDescLabel" styleClass="gd-desc" text="Description" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="gd-progress-row">
               <children>
                  <Label styleClass="gd-progress-lbl" text="Progression" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="progressPctLabel" styleClass="gd-progress-pct" text="0%" />
               </children>
            </HBox>
            <ProgressBar fx:id="goalProgressBar" maxWidth="Infinity" prefHeight="8" styleClass="gd-main-progress" />

            <HBox spacing="16" styleClass="gd-date-row">
               <children>
                  <VBox spacing="6" styleClass="gd-date-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="gd-date-icon" text="📅" />
                        <Label styleClass="gd-date-k" text="Date de début" />
                        <Label fx:id="startDateLabel" styleClass="gd-date-v" text="—" />
                     </children>
                  </VBox>
                  <VBox spacing="6" styleClass="gd-date-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="gd-date-icon" text="📆" />
                        <Label styleClass="gd-date-k" text="Date de fin" />
                        <Label fx:id="endDateLabel" styleClass="gd-date-v" text="—" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="gd-goal-actions">
               <children>
                  <Button fx:id="editGoalBtn" mnemonicParsing="false" onAction="#onEditGoal" styleClass="btn-gd-edit-goal" text="✏ Modifier l'objectif" />
                  <Button fx:id="deleteGoalBtn" mnemonicParsing="false" onAction="#onDeleteGoal" styleClass="btn-gd-delete-goal" text="🗑 Supprimer l'objectif" />
               </children>
            </HBox>

            <Separator styleClass="gd-sep" />

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="gd-routines-head">
               <children>
                  <Button fx:id="openChatBtn" mnemonicParsing="false" onAction="#onOpenChatroom" styleClass="btn-gd-chat" text="💬 Ouvrir le chatroom" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="routinesCountLabel" styleClass="gd-routines-title" text="Routines (0)" />
                  <Button fx:id="newRoutineBtn" mnemonicParsing="false" onAction="#onNewRoutine" styleClass="btn-gd-new-routine" text="＋ Nouvelle Routine" />
               </children>
            </HBox>

            <VBox fx:id="routinesEmptyBox" alignment="CENTER" spacing="16" styleClass="gd-empty">
               <children>
                  <Label styleClass="gd-empty-icon" text="📅" />
                  <Label styleClass="gd-empty-title" text="Aucune routine" />
                  <Label styleClass="gd-empty-sub" text="Créez votre première routine pour cet objectif" />
                  <Button mnemonicParsing="false" onAction="#onNewRoutine" styleClass="btn-gd-empty-cta" text="＋ Créer une routine" />
               </children>
               <padding>
                  <Insets bottom="40" left="24" right="24" top="32" />
               </padding>
            </VBox>

            <VBox fx:id="routinesListBox" spacing="10" styleClass="gd-routines-list">
               <padding>
                  <Insets bottom="32" left="4" right="4" top="8" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="24" left="32" right="32" top="20" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
