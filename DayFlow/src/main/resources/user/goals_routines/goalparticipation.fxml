<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.goals_routines.GoalParticipationController"
      prefWidth="400" prefHeight="350">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Participation aux Goals" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="User ID :" prefWidth="80"/>
        <TextField fx:id="userIdField" promptText="ex: 1" prefWidth="200"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Goal ID :" prefWidth="80"/>
        <TextField fx:id="goalIdField" promptText="ex: 1" prefWidth="200"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rôle :" prefWidth="80"/>
        <ComboBox fx:id="roleBox" prefWidth="200"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Statut :" prefWidth="80"/>
        <ComboBox fx:id="statusBox" prefWidth="200"/>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="updateIdField" promptText="ID à modifier/supprimer" prefWidth="200"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#addParticipation" prefWidth="110"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Modifier" onAction="#updateParticipation" prefWidth="110"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Supprimer" onAction="#deleteParticipation" prefWidth="110"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: green;"/>
</VBox>
