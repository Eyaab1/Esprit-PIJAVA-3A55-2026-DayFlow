<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane styleClass="dashboard-root" stylesheets="@user_dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.userdashboard.UserDashboardController">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox alignment="TOP_CENTER" styleClass="dashboard-inner">
               <children>
                  <VBox alignment="TOP_LEFT" spacing="14.0" styleClass="hero-dashboard">
                     <children>
                        <Label styleClass="pill-welcome" text="✨ Bienvenue sur votre espace" />
                        <Label fx:id="greetingLabel" styleClass="greeting-title" text="Bonjour ! 👋" />
                        <Label styleClass="greeting-sub" text="Prêt à atteindre vos objectifs aujourd'hui ?" />
                     </children>
                  </VBox>
                  <VBox styleClass="stats-summary-wrap">
                     <children>
                        <HBox alignment="CENTER" styleClass="stats-summary-bar">
                           <children>
                              <VBox alignment="CENTER" spacing="6.0" styleClass="stat-item" HBox.hgrow="ALWAYS">
                                 <children>
                                    <StackPane styleClass="stat-icon-frame">
                                       <children>
                                          <SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z" styleClass="stat-svg" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="statSessionsLabel" styleClass="stat-value" text="0" />
                                    <Label styleClass="stat-caption" text="Sessions" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="6.0" styleClass="stat-item" HBox.hgrow="ALWAYS">
                                 <children>
                                    <StackPane styleClass="stat-icon-frame">
                                       <children>
                                          <SVGPath content="M12 5c-3.87 0-7 3.13-7 7s3.13 7 7 7 7-3.13 7-7-3.13-7-7-7zm0 12c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" styleClass="stat-svg" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="statGoalsLabel" styleClass="stat-value" text="0" />
                                    <Label styleClass="stat-caption" text="Objectifs" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="6.0" styleClass="stat-item" HBox.hgrow="ALWAYS">
                                 <children>
                                    <StackPane styleClass="stat-icon-frame">
                                       <children>
                                          <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" styleClass="stat-svg" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="statRoutinesLabel" styleClass="stat-value" text="0" />
                                    <Label styleClass="stat-caption" text="Routines" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="6.0" styleClass="stat-item" HBox.hgrow="ALWAYS">
                                 <children>
                                    <StackPane styleClass="stat-icon-frame">
                                       <children>
                                          <SVGPath content="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.59 1.21 1.55 2.26 2.79 2.93V20h2v-5.13c1.24-.67 2.2-1.72 2.79-2.93C18.08 12.63 20 10.55 20 8V7c0-1.1-.9-2-2-2zM5 8V7h14v1c0 1.3-.58 2.48-1.56 3.26C16.46 12.04 14.82 12 13 12c-1.82 0-3.5.04-5.44 1.26-.98-.78-2.46-1.74-3.44-2.52C3.58 10.48 3 9.3 3 8zm7 10h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1z" styleClass="stat-svg" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="statAchievementsLabel" styleClass="stat-value" text="0" />
                                    <Label styleClass="stat-caption" text="Réalisations" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox alignment="TOP_LEFT" spacing="16.0">
                     <children>
                        <Label styleClass="section-title" text="⚡ Actions rapides" />
                        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="quick-row">
                           <children>
                              <VBox alignment="TOP_LEFT" onMouseClicked="#onQuickFindCoach" spacing="8.0" styleClass="quick-card">
                                 <children>
                                    <Label styleClass="quick-icon" text="👤➕" />
                                    <Label styleClass="quick-title" text="Trouver un coach" />
                                    <Label styleClass="quick-desc" text="Découvre des profils alignés avec tes objectifs." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_LEFT" onMouseClicked="#onQuickCalendar" spacing="8.0" styleClass="quick-card">
                                 <children>
                                    <Label styleClass="quick-icon" text="📆" />
                                    <Label styleClass="quick-title" text="Mon calendrier" />
                                    <Label styleClass="quick-desc" text="Visualise tes sessions et créneaux à venir." wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_LEFT" onMouseClicked="#onQuickNewGoal" spacing="8.0" styleClass="quick-card">
                                 <children>
                                    <Label styleClass="quick-icon" text="🎯" />
                                    <Label styleClass="quick-title" text="Nouvel objectif" />
                                    <Label styleClass="quick-desc" text="Fixe un objectif SMART et suis ta progression." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Region prefHeight="8.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <Button focusTraversable="false" mnemonicParsing="false" onAction="#onMesReclamations" styleClass="fab-feedback" text="💬" AnchorPane.bottomAnchor="28.0" AnchorPane.rightAnchor="32.0" />
   </children>
</AnchorPane>
