<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.interaction.CommunityDiscussionsController"
      styleClass="comm-disc-root" stylesheets="@community_discussions.css">
   <children>
      <HBox styleClass="comm-disc-header" alignment="CENTER_LEFT" spacing="16">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="comm-disc-emoji" text="💬" />
                  <VBox spacing="2">
                     <children>
                        <Label styleClass="comm-disc-title" text="Discussions &amp; salons" />
                        <Label styleClass="comm-disc-sub" text="Rejoindre un objectif, envoyer une demande au propriétaire, puis accéder au chat une fois accepté."
                               wrapText="true" maxWidth="640" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="backBtn" mnemonicParsing="false" onAction="#onBack" styleClass="btn-comm-back" text="← Community" />
         </children>
      </HBox>
      <HBox styleClass="comm-disc-toolbar" alignment="CENTER_LEFT" spacing="12">
         <children>
            <Label styleClass="filter-label-comm" text="Rechercher" />
            <TextField fx:id="searchField" promptText="Titre ou description…" styleClass="comm-disc-search" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <ScrollPane fitToWidth="true" styleClass="comm-disc-scroll" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="cardsFlow" styleClass="comm-disc-flow" hgap="20" vgap="20" prefWrapLength="1080" />
         </content>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="24" left="28" right="28" top="20" />
   </padding>
</VBox>
