<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root container: full-height column for the whole posts feed screen. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.interaction.PostsFeedController"
      styleClass="posts-feed-root" stylesheets="@posts_feed.css">
   <!-- Root’s direct children (single inner column that fills height). -->
   <children>
      <!-- Inner column: holds toolbar + scroll area; VBox.vgrow=ALWAYS makes it take all vertical space. -->
      <VBox styleClass="posts-feed-inner" VBox.vgrow="ALWAYS">
         <children>
            <!-- Toolbar row: sort / filter / tag dropdowns, spacer, then “Create post”. -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="posts-toolbar">
               <children>
                  <ComboBox fx:id="sortCombo" prefWidth="200.0" styleClass="posts-combo" />
                  <ComboBox fx:id="filterCombo" prefWidth="200.0" styleClass="posts-combo" />
                  <ComboBox fx:id="tagCombo" prefWidth="200.0" styleClass="posts-combo" />
                  <!-- Spacer: absorbs extra width so the button stays right-aligned. -->
                  <Region HBox.hgrow="ALWAYS" />
                  <!-- Opens the “new post” dialog (handler onCreatePost in the controller). -->
                  <Button fx:id="createPostBtn" mnemonicParsing="false" onAction="#onCreatePost" styleClass="btn-create-post" text="＋  Créer un post" />
               </children>
               <!-- Padding inside the toolbar HBox (bottom gap under the controls). -->
               <padding>
                  <Insets bottom="8.0" left="0.0" right="0.0" top="0.0" />
               </padding>
            </HBox>
            
            <!-- Success Alert (hidden by default) -->
            <Label fx:id="successAlert" managed="false" styleClass="success-alert" visible="false" wrapText="true" />
            
            <!-- Warning Alert (hidden by default) -->
            <Label fx:id="warningAlert" managed="false" styleClass="warning-alert" visible="false" wrapText="true" />
            
            <!-- Inline Post Creation Form (hidden by default) -->
            <VBox fx:id="createPostForm" managed="false" styleClass="create-post-form" visible="false">
               <children>
                  <Label styleClass="create-post-title" text="Créer un nouveau post" />
                  
                  <!-- Error Label -->
                  <Label fx:id="createPostErrorLabel" managed="false" styleClass="create-post-error" visible="false" wrapText="true" />
                  
                  <!-- Title Field -->
                  <Label styleClass="form-label" text="Titre *" />
                  <TextField fx:id="createPostTitleField" promptText="Entrez le titre de votre post" styleClass="form-input" />
                  
                  <!-- Content Area -->
                  <Label styleClass="form-label" text="Contenu" />
                  <TextArea fx:id="createPostContentArea" prefRowCount="4" promptText="Partagez vos pensées..." styleClass="form-textarea" wrapText="true" />
                  
                  <!-- Auto-tag hint -->
                  <Label styleClass="form-hint" text="✨ Les tags seront générés automatiquement par IA" />
                  
                  <!-- Status Combo -->
                  <Label styleClass="form-label" text="Statut" />
                  <ComboBox fx:id="createPostStatusCombo" prefWidth="250.0" styleClass="form-combo" />
                  
                  <!-- Date Picker (hidden by default, shown when "Programmer" is selected) -->
                  <Label fx:id="createPostDateLabel" managed="false" styleClass="form-label" text="Date de publication" visible="false" />
                  <DatePicker fx:id="createPostDatePicker" managed="false" prefWidth="250.0" styleClass="form-datepicker" visible="false" />
                  
                  <!-- Time Field (hidden by default, shown when "Programmer" is selected) -->
                  <Label fx:id="createPostTimeLabel" managed="false" styleClass="form-label" text="Heure (HH:mm)" visible="false" />
                  <TextField fx:id="createPostTimeField" managed="false" prefWidth="250.0" promptText="14:30" styleClass="form-input" visible="false" />
                  
                  <!-- Action Buttons -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="form-actions">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onPublishPost" styleClass="btn-primary" text="Publier" />
                        <Button mnemonicParsing="false" onAction="#onCancelPost" styleClass="btn-cancel-post" text="Annuler" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
               </padding>
            </VBox>
            
            <!-- Scrollable viewport for the feed; fitToWidth=true stretches content to the pane width. -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="posts-scroll" VBox.vgrow="ALWAYS">
               <!-- Single child of ScrollPane: the scrollable body. -->
               <content>
                  <!-- Vertical list built in code (buildPostCard): each post is added as a child here. -->
                  <VBox fx:id="postsContainer" spacing="20.0" styleClass="posts-list-wrap">
                     <!-- Outer padding around the list of cards (bottom space for end-of-scroll comfort). -->
                     <padding>
                        <Insets bottom="48.0" left="0.0" right="8.0" top="8.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
