<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MesDemandesController"
      spacing="28" styleClass="root" stylesheets="@mes_demandes.css">
    <padding>
        <Insets top="40" right="44" bottom="40" left="44"/>
    </padding>

    <!-- Navigation -->
    <HBox alignment="CENTER_LEFT" spacing="14">
        <Button text="← Retour" onAction="#goBack" styleClass="nav-button-back"/>
        <Button text="Gérer sessions" onAction="#goToSessions" styleClass="nav-button-sessions"/>
    </HBox>
    
    <!-- En-tête -->
    <VBox spacing="12" alignment="CENTER">
        <Label text="Mes demandes de coaching" styleClass="header-title">
            <font>
                <Font name="System Bold" size="36"/>
            </font>
        </Label>
        <Label text="Gérez vos demandes de coaching en cours" styleClass="header-subtitle">
            <font>
                <Font size="16"/>
            </font>
        </Label>
    </VBox>
    
    <!-- Carte principale -->
    <VBox spacing="24" styleClass="main-card">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>
        
        <!-- Statistiques rapides -->
        <HBox spacing="24" alignment="CENTER">
            <VBox spacing="8" alignment="CENTER" styleClass="stat-card, stat-card-total" HBox.hgrow="ALWAYS">
                <Label text="Total" styleClass="stat-label"/>
                <Label fx:id="totalLabel" text="0" styleClass="stat-value-total">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="8" alignment="CENTER" styleClass="stat-card, stat-card-pending" HBox.hgrow="ALWAYS">
                <Label text="En attente" styleClass="stat-label"/>
                <Label fx:id="pendingLabel" text="0" styleClass="stat-value-pending">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="8" alignment="CENTER" styleClass="stat-card, stat-card-accepted" HBox.hgrow="ALWAYS">
                <Label text="Acceptées" styleClass="stat-label"/>
                <Label fx:id="acceptedLabel" text="0" styleClass="stat-value-accepted">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="8" alignment="CENTER" styleClass="stat-card, stat-card-declined" HBox.hgrow="ALWAYS">
                <Label text="Refusées" styleClass="stat-label"/>
                <Label fx:id="declinedLabel" text="0" styleClass="stat-value-declined">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </VBox>
        </HBox>
        
        <!-- Barre de recherche et filtres -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍 Rechercher par coach, message..." 
                       HBox.hgrow="ALWAYS" styleClass="search-field">
            </TextField>
            
            <ComboBox fx:id="statusFilter" promptText="Statut" styleClass="filter-combo" prefWidth="140"/>
            
            <ComboBox fx:id="priorityFilter" promptText="Priorité" styleClass="filter-combo" prefWidth="140"/>

            <DatePicker fx:id="dateFromFilter" promptText="Du" styleClass="date-picker" prefWidth="140"/>
            
            <DatePicker fx:id="dateToFilter" promptText="Au" styleClass="date-picker" prefWidth="140"/>
            
            <Button fx:id="filterBtn" text="Filtrer" styleClass="filter-button">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
        </HBox>
        
        <!-- TableView -->
        <TableView fx:id="tableRequests" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="70" minWidth="60" maxWidth="90"/>
                <TableColumn fx:id="coachColumn" text="Coach" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="messageColumn" text="Message" prefWidth="320" minWidth="200"/>
                <TableColumn fx:id="prioriteColumn" text="Priorité" prefWidth="110" minWidth="90"/>
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="160" minWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <!-- Boutons d'action -->
        <HBox spacing="16" alignment="CENTER">
            <Button fx:id="newRequestBtn" text="✨ Nouvelle demande" styleClass="action-button-new">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="payButton" text="💳 Payer la séance" styleClass="action-button-pay">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="updateBtn" text="✏️ Modifier" styleClass="action-button-edit">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="deleteBtn" text="🗑️ Supprimer" styleClass="action-button-delete">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="refreshBtn" text="🔄 Actualiser" styleClass="action-button-refresh">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
        </HBox>
        
        <!-- Barre de sélection -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="selection-bar">
            <Label text="Sélection :" styleClass="selection-label-title"/>
            <Label fx:id="selectionLabel" text="Aucune demande sélectionnée" styleClass="selection-label-value"/>
        </HBox>
        
    </VBox>
    
</VBox>
