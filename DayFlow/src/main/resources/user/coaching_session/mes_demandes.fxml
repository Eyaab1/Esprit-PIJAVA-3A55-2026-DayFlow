<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.coaching_session.MesDemandesController"
      spacing="25" style="-fx-background-color: #f5f7fb;">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Retour" onAction="#goBack"
                style="-fx-background-color: transparent; -fx-text-fill: #6c5ce7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Gérer sessions" onAction="#goToSessions"
                style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14 8 14; -fx-cursor: hand;"/>
    </HBox>
    
    <!-- En-tête -->
    <VBox spacing="10" alignment="CENTER">
        <Label text="Mes demandes de coaching" 
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2d3436;">
            <font>
                <Font name="System Bold" size="32"/>
            </font>
        </Label>
        <Label text="Gérez vos demandes de coaching en cours" 
               style="-fx-font-size: 16px; -fx-text-fill: #636e72;">
            <font>
                <Font size="16"/>
            </font>
        </Label>
    </VBox>
    
    <!-- Carte contenant le tableau et les boutons -->
    <VBox spacing="20" 
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>
        
        <!-- Statistiques rapides -->
        <HBox spacing="20" alignment="CENTER">
            <VBox spacing="5" alignment="CENTER" 
                  style="-fx-background-color: #e3f2fd; -fx-background-radius: 8; -fx-padding: 15;">
                <Label text="Total" style="-fx-font-size: 12px; -fx-text-fill: #636e72;"/>
                <Label fx:id="totalLabel" text="0" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="5" alignment="CENTER" 
                  style="-fx-background-color: #fff3e0; -fx-background-radius: 8; -fx-padding: 15;">
                <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #636e72;"/>
                <Label fx:id="pendingLabel" text="0" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f57c00;">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="5" alignment="CENTER" 
                  style="-fx-background-color: #e8f5e9; -fx-background-radius: 8; -fx-padding: 15;">
                <Label text="Acceptées" style="-fx-font-size: 12px; -fx-text-fill: #636e72;"/>
                <Label fx:id="acceptedLabel" text="0" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #43a047;">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </VBox>
            
            <VBox spacing="5" alignment="CENTER" 
                  style="-fx-background-color: #ffebee; -fx-background-radius: 8; -fx-padding: 15;">
                <Label text="Refusées" style="-fx-font-size: 12px; -fx-text-fill: #636e72;"/>
                <Label fx:id="declinedLabel" text="0" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e53935;">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </VBox>
        </HBox>
        
        <!-- Barre de recherche et filtres -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher..." 
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #f8f9fa; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
            </TextField>
            
            <ComboBox fx:id="statusFilter" promptText="Statut" 
                      style="-fx-background-color: #f8f9fa; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
            </ComboBox>
            
            <ComboBox fx:id="priorityFilter" promptText="Priorité" 
                      style="-fx-background-color: #f8f9fa; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
            </ComboBox>

            <DatePicker fx:id="dateFromFilter" promptText="Du"
                        style="-fx-background-color: #f8f9fa; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8;"/>
            <DatePicker fx:id="dateToFilter" promptText="Au"
                        style="-fx-background-color: #f8f9fa; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8;"/>
            
            <Button fx:id="filterBtn" text="Filtrer" 
                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
        </HBox>
        
        <!-- TableView -->
        <TableView fx:id="tableRequests" 
                   style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60" minWidth="60" maxWidth="80">
                </TableColumn>
                <TableColumn fx:id="coachColumn" text="Coach" prefWidth="180" minWidth="150">
                </TableColumn>
                <TableColumn fx:id="messageColumn" text="Message" prefWidth="300" minWidth="200">
                </TableColumn>
                <TableColumn fx:id="prioriteColumn" text="Priorité" prefWidth="100" minWidth="80">
                </TableColumn>
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120" minWidth="100">
                </TableColumn>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" minWidth="120">
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <!-- Boutons d'action -->
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="newRequestBtn" text="Nouvelle demande" 
                    style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 30 12 30; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="updateBtn" text="Modifier" 
                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 30 12 30; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="deleteBtn" text="Supprimer" 
                    style="-fx-background-color: #d63031; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 30 12 30; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
            
            <Button fx:id="refreshBtn" text="Actualiser" 
                    style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 30 12 30; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>
        </HBox>
        
        <!-- Informations sur la sélection -->
        <HBox spacing="10" alignment="CENTER_LEFT" 
              style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 15;">
            <Label text="Sélection:" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #636e72;"/>
            <Label fx:id="selectionLabel" text="Aucune demande sélectionnée" 
                   style="-fx-font-size: 13px; -fx-text-fill: #2d3436;"/>
        </HBox>
        
    </VBox>
    
</VBox>
