<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.CalendarSyncStatusController"
      spacing="10" alignment="CENTER_LEFT"
      style="-fx-padding: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-color: #f9fafb;">

    <!-- Sync Status Indicator -->
    <Circle fx:id="syncIndicator" radius="6" fill="#ef4444"/>

    <!-- Status Text -->
    <VBox spacing="2">
        <Label fx:id="statusTitle" text="Not Synced" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label fx:id="statusDetails" text="Click to sync with Google Calendar" style="-fx-font-size: 10; -fx-text-fill: #6b7280;"/>
    </VBox>

    <!-- Spacer -->
    <Region HBox.hgrow="ALWAYS"/>

    <!-- Sync Button -->
    <Button fx:id="syncButton" text="📅 Sync" style="-fx-padding: 6 12; -fx-font-size: 11;"/>

    <!-- More Options -->
    <MenuButton fx:id="optionsMenu" text="⋮" style="-fx-padding: 6 10; -fx-font-size: 11;">
        <items>
            <MenuItem text="View in Google Calendar" onAction="#handleViewInCalendar"/>
            <MenuItem text="Remove from Calendar" onAction="#handleRemoveFromCalendar"/>
            <SeparatorMenuItem/>
            <MenuItem text="Sync Settings" onAction="#handleSyncSettings"/>
        </items>
    </MenuButton>

</HBox>
