<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.coaching_session.CoachSessionsController"
      spacing="32" stylesheets="@coach_sessions.css" styleClass="root">
    <padding>
        <Insets top="40" right="44" bottom="60" left="44"/>
    </padding>
    
    <!-- En-tête -->
    <VBox spacing="12" alignment="CENTER">
        <Label text="📅 Mes sessions de coaching" styleClass="header-title">
            <font>
                <Font name="System Bold" size="36"/>
            </font>
        </Label>
        <Label text="Gérez vos sessions planifiées" styleClass="header-subtitle">
            <font>
                <Font size="16"/>
            </font>
        </Label>
    </VBox>
    
    <!-- Statistiques -->
    <HBox spacing="24" alignment="CENTER">
        <VBox spacing="8" alignment="CENTER" styleClass="stat-card-blue">
            <Label text="Total" styleClass="stat-label"/>
            <Label fx:id="totalSessionsLabel" text="0" styleClass="stat-value-blue">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
        </VBox>
        
        <VBox spacing="8" alignment="CENTER" styleClass="stat-card-orange">
            <Label text="Planifiées" styleClass="stat-label"/>
            <Label fx:id="scheduledLabel" text="0" styleClass="stat-value-orange">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
        </VBox>
        
        <VBox spacing="8" alignment="CENTER" styleClass="stat-card-green">
            <Label text="Terminées" styleClass="stat-label"/>
            <Label fx:id="completedLabel" text="0" styleClass="stat-value-green">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
        </VBox>
    </HBox>
    
    <!-- Carte principale -->
    <VBox spacing="24" styleClass="main-card">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>
        
        <!-- Barre d'actions -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <Button fx:id="refreshBtn" text="🔄 Actualiser" styleClass="btn-refresh"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="selectionLabel" text="Aucune session sélectionnée" styleClass="selection-label"/>
        </HBox>
        
        <!-- TableView -->
        <TableView fx:id="sessionsTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60" minWidth="60" maxWidth="80"/>
                <TableColumn fx:id="clientColumn" text="Client" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="timeColumn" text="Heure" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="durationColumn" text="Durée" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="objectiveColumn" text="Objectif" prefWidth="200" minWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120" minWidth="100"/>
                <TableColumn fx:id="priceColumn" text="Prix" prefWidth="100" minWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <!-- Boutons d'action -->
        <HBox spacing="16" alignment="CENTER">
            <Button fx:id="modifyBtn" text="✏️ Modifier" styleClass="btn-modify">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>
            <Button fx:id="deleteBtn" text="🗑️ Supprimer" styleClass="btn-delete">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>
            <Button fx:id="completeBtn" text="✅ Marquer comme terminée" styleClass="btn-complete">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>
            <Button fx:id="evaluateBtn" text="🧠 Évaluer progression" styleClass="btn-modify">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>
            <Button fx:id="reportBtn" text="📈 Voir rapport" styleClass="btn-refresh">
                <font>
                    <Font name="System Bold" size="15"/>
                </font>
            </Button>
        </HBox>
        
    </VBox>
    
</VBox>
