<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.CoachingRequestController"
            fitToWidth="true"
            style="-fx-background-color: #eef2ff; -fx-background: #eef2ff;">

    <VBox spacing="0" alignment="TOP_CENTER"
          style="-fx-background-color: #eef2ff;">

        <!-- Barre navigation — pastel -->
        <HBox alignment="CENTER_LEFT" spacing="20" maxWidth="Infinity"
              style="-fx-background-color: #fafbff; -fx-border-color: #e0e7ff; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="14" right="32" bottom="14" left="32"/>
            </padding>

            <Label text="DayFlow" styleClass="logo-text"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #6366f1;">
                <font>
                    <Font name="System Bold" size="23"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="6" alignment="CENTER">
                <Button fx:id="accueilButton" text="Accueil" styleClass="nav-button"
                        onAction="#handleAccueil"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="objectifsButton" text="Objectifs" styleClass="nav-button"
                        onAction="#handleObjectifs"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="communityButton" text="Community" styleClass="nav-button"
                        onAction="#handleCommunity"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="calendrierButton" text="Calendrier" styleClass="nav-button"
                        onAction="#handleCalendrier"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="favorisButton" text="Favoris" styleClass="nav-button"
                        onAction="#handleFavoris"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="postsButton" text="Posts" styleClass="nav-button"
                        onAction="#handlePosts"
                        style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 12 8 12; -fx-background-radius: 8;">
                </Button>
                <Button fx:id="mesDemandesButton" text="Mes demandes" styleClass="nav-button"
                        onAction="#handleMesDemandes"
                        style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-size: 13px; -fx-font-weight: 600; -fx-cursor: hand; -fx-padding: 8 14 8 14; -fx-background-radius: 10;">
                </Button>
            </HBox>

            <Button fx:id="userButton" text="U" styleClass="user-button"
                    style="-fx-background-color: linear-gradient(to bottom right, #a5b4fc, #f9a8d4); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 42; -fx-min-height: 42; -fx-cursor: hand;">
            </Button>
        </HBox>

        <!-- Contenu principal — centré, largeur max cohérente -->
        <VBox spacing="32" alignment="TOP_CENTER" maxWidth="Infinity"
               style="-fx-background-color: #eef2ff;">
            <padding>
                <Insets top="36" right="28" bottom="48" left="28"/>
            </padding>

            <!-- Hero recherche -->
            <VBox spacing="16" alignment="CENTER" maxWidth="1040">
                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #e0e7ff; -fx-background-radius: 20; -fx-padding: 28 32 28 32;">
                    <Label text="Trouvez votre coach idéal"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #3730a3;">
                        <font>
                            <Font name="System Bold" size="30"/>
                        </font>
                    </Label>
                    <Label text="Recherchez parmi nos experts certifiés pour atteindre vos objectifs"
                           style="-fx-font-size: 15px; -fx-text-fill: #5b21b6; -fx-wrap-text: true; -fx-text-alignment: center;">
                        <font>
                            <Font size="15"/>
                        </font>
                    </Label>
                    <HBox spacing="12" alignment="CENTER" maxWidth="640">
                        <TextField fx:id="searchTextField" promptText="Rechercher un coach..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #ffffff; -fx-border-color: #c7d2fe; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 12 18 12 18; -fx-font-size: 14px;">
                        </TextField>
                        <Button fx:id="searchButton" text="Rechercher" styleClass="primary-button"
                                style="-fx-background-color: #a5b4fc; -fx-text-fill: #1e1b4b; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 12 26 12 26; -fx-cursor: hand;">
                            <font>
                                <Font name="System Bold" size="14"/>
                            </font>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Filtres -->
            <VBox spacing="18" maxWidth="1040" alignment="TOP_LEFT"
                  style="-fx-background-color: #fafbff; -fx-background-radius: 16; -fx-border-color: #e0e7ff; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.08), 14, 0, 0, 2);">
                <padding>
                    <Insets top="22" right="26" bottom="22" left="26"/>
                </padding>

                <Label text="Filtres avancés"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #4338ca;">
                    <font>
                        <Font name="System Bold" size="17"/>
                    </font>
                </Label>

                <FlowPane hgap="14" vgap="14" prefWrapLength="900" columnHalignment="LEFT">
                    <VBox spacing="6" minWidth="140" prefWidth="160">
                        <Label text="Spécialité"
                               style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        <ComboBox fx:id="specialiteComboBox" promptText="Toutes" maxWidth="Infinity"
                                  styleClass="filter-combo"
                                  style="-fx-background-color: #f5f3ff; -fx-border-color: #ddd6fe; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8;"/>
                    </VBox>
                    <VBox spacing="6" minWidth="100" prefWidth="120">
                        <Label text="Prix min"
                               style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="prixMinTextField" promptText="0" styleClass="filter-field"
                                   style="-fx-background-color: #ecfdf5; -fx-border-color: #a7f3d0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" minWidth="100" prefWidth="120">
                        <Label text="Prix max"
                               style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="prixMaxTextField" promptText="1000" styleClass="filter-field"
                                   style="-fx-background-color: #ecfdf5; -fx-border-color: #a7f3d0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" minWidth="120" prefWidth="140">
                        <Label text="Note minimum"
                               style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        <ComboBox fx:id="noteComboBox" promptText="Toutes" maxWidth="Infinity"
                                  styleClass="filter-combo"
                                  style="-fx-background-color: #fffbeb; -fx-border-color: #fde68a; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8;"/>
                    </VBox>
                    <VBox spacing="6" minWidth="120" prefWidth="160">
                        <Label text="Disponibilité"
                               style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        <ComboBox fx:id="disponibiliteComboBox" promptText="Toutes" maxWidth="Infinity"
                                  styleClass="filter-combo"
                                  style="-fx-background-color: #fce7f3; -fx-border-color: #fbcfe8; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8;"/>
                    </VBox>
                    <VBox spacing="6" alignment="BOTTOM_LEFT" minWidth="100">
                        <Label text=" " style="-fx-font-size: 12px;"/>
                        <Button fx:id="applyFiltersButton" text="Appliquer" styleClass="primary-button"
                                style="-fx-background-color: #99f6e4; -fx-text-fill: #115e59; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 22 10 22; -fx-cursor: hand;"/>
                    </VBox>
                </FlowPane>
            </VBox>

            <!-- Liste coachs — grille fluide -->
            <VBox spacing="14" maxWidth="1040" alignment="TOP_LEFT">
                <VBox spacing="4">
                    <Label text="Nos coachs disponibles"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3730a3;">
                        <font>
                            <Font name="System Bold" size="22"/>
                        </font>
                    </Label>
                    <Label text="Découvrez nos experts certifiés prêts à vous accompagner"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="false"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <FlowPane fx:id="coachCardsFlow" hgap="16" vgap="16" alignment="TOP_LEFT"
                              maxWidth="Infinity" prefWrapLength="980"
                              style="-fx-background-color: transparent;"/>
                </ScrollPane>
            </VBox>

            <!-- Formulaire demande -->
            <VBox spacing="12" alignment="CENTER" maxWidth="1040">
                <Label text="Faire une demande de coaching"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3730a3;">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
                <Label text="Choisissez votre coach et décrivez vos objectifs"
                       style="-fx-font-size: 15px; -fx-text-fill: #6b7280;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Label>
            </VBox>

            <HBox alignment="CENTER" maxWidth="1040">
                <VBox spacing="22" maxWidth="720" HBox.hgrow="NEVER" fillWidth="true"
                      style="-fx-background-color: #fefeff; -fx-background-radius: 18; -fx-border-color: #e0e7ff; -fx-border-radius: 18; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.07), 16, 0, 0, 3);">
                    <padding>
                        <Insets top="32" right="36" bottom="32" left="36"/>
                    </padding>

                    <Label text="Votre demande"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6366f1; -fx-letter-spacing: 0.5;"/>

                    <VBox spacing="8">
                        <Label text="Sélectionnez votre coach"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                        <ComboBox fx:id="coachComboBox" promptText="Choisir un coach..." maxWidth="Infinity"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #c7d2fe; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <Separator style="-fx-background-color: #e0e7ff;"/>

                    <VBox spacing="8">
                        <Label text="Votre message"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                        <TextArea fx:id="messageTextArea" promptText="Décrivez vos objectifs et attentes..."
                                  prefRowCount="5" wrapText="true"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #c7d2fe; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 13px;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Priorité de la demande"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: #f5f3ff; -fx-background-radius: 12; -fx-padding: 10 14 10 14; -fx-border-color: #e9d5ff; -fx-border-radius: 12; -fx-border-width: 1;">
                            <RadioButton fx:id="normalRadio" text="Normal" selected="true"
                                         style="-fx-font-size: 13px; -fx-text-fill: #4b5563;">
                                <toggleGroup>
                                    <ToggleGroup fx:id="priorityToggleGroup"/>
                                </toggleGroup>
                            </RadioButton>
                            <RadioButton fx:id="moyenRadio" text="Moyen" toggleGroup="$priorityToggleGroup"
                                         style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>
                            <RadioButton fx:id="urgentRadio" text="Urgent" toggleGroup="$priorityToggleGroup"
                                         style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="14">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Objectif principal"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <ComboBox fx:id="objectifComboBox" promptText="Sélectionner..." maxWidth="Infinity"
                                      style="-fx-background-color: #fff7ed; -fx-border-color: #fed7aa; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Niveau actuel"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <ComboBox fx:id="niveauComboBox" promptText="Sélectionner..." maxWidth="Infinity"
                                      style="-fx-background-color: #fff7ed; -fx-border-color: #fed7aa; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Fréquence souhaitée"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <ComboBox fx:id="frequenceComboBox" promptText="Sélectionner..." maxWidth="Infinity"
                                      style="-fx-background-color: #ecfeff; -fx-border-color: #a5f3fc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Budget par séance"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <TextField fx:id="budgetTextField" promptText="Ex: 50€"
                                       style="-fx-background-color: #ecfeff; -fx-border-color: #a5f3fc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="submitButton" text="Envoyer ma demande" maxWidth="Infinity"
                            style="-fx-background-color: linear-gradient(to right, #a5b4fc, #c4b5fd); -fx-text-fill: #1e1b4b; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 14 28 14 28; -fx-cursor: hand;">
                        <font>
                            <Font name="System Bold" size="15"/>
                        </font>
                    </Button>

                    <Label fx:id="aiAnalysisStatusLabel"
                           text="Commencez à écrire votre message pour lancer l'analyse IA."
                           wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>

                    <VBox fx:id="aiResultCard" spacing="10" visible="false" managed="false"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-border-color: #c7d2fe; -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 14 16 14 16;">
                        <Label text="Résultat de l'analyse IA"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4338ca;"/>

                        <Label fx:id="detectedNeedValueLabel"
                               text="Besoin détecté : -"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #334155;"/>
                        <Label fx:id="recommendedCoachValueLabel"
                               text="Coach recommandé : -"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #334155;"/>
                        <Label fx:id="compatibilityScoreValueLabel"
                               text="Score de compatibilité : -"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #334155;"/>
                        <Label fx:id="justificationValueLabel"
                               text="Justification : -"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #334155;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
