<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.coaching_session.CoachRequestsController"
            fitToWidth="true"
            stylesheets="@coach_requests.css"
            styleClass="root">

    <VBox spacing="0">
        
        <!-- Navbar moderne -->
        <HBox alignment="CENTER_LEFT" spacing="20" 
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>

            <Label text="DayFlow" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6366f1;">
                <font><Font name="System Bold" size="24"/></font>
            </Label>
            
            <Label text="— Coach" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8" alignment="CENTER">
                <Button text="Accueil" styleClass="nav-button"/>
                <Button text="Objectifs" styleClass="nav-button"/>
                <Button text="Communauté" styleClass="nav-button"/>
                <Button text="Calendrier" styleClass="nav-button"/>
                <Button text="Favoris" styleClass="nav-button"/>
                <Button text="Posts" styleClass="nav-button"/>
                <Button text="Mes demandes" styleClass="nav-button"
                        style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-weight: 700;"/>
                <Button text="Gérer sessions" styleClass="nav-button"/>
            </HBox>

            <Button text="Déconnexion" 
                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
        </HBox>

        <!-- Contenu principal -->
        <VBox spacing="32">
            <padding>
                <Insets top="36" right="44" bottom="60" left="44"/>
            </padding>
            
            <!-- En-tête avec gradient -->
            <VBox spacing="14" alignment="CENTER_LEFT" styleClass="hero-header">
                <Label text="📋 Demandes de coaching" styleClass="hero-title">
                    <font><Font name="System Bold" size="36"/></font>
                </Label>
                <Label text="Gérez les demandes reçues et planifiez vos sessions" styleClass="hero-subtitle">
                    <font><Font size="16"/></font>
                </Label>
            </VBox>
            
            <!-- Statistiques modernes -->
            <GridPane hgap="20" vgap="20">
                <!-- En attente -->
                <VBox spacing="12" alignment="TOP_LEFT" GridPane.columnIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region style="-fx-background-color: #fef3c7; -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48;"/>
                        <VBox spacing="4">
                            <Label text="En attente" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 500;"/>
                            <Label fx:id="pendingCountLabel" text="0" 
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;">
                                <font><Font name="System Bold" size="28"/></font>
                            </Label>
                        </VBox>
                    </HBox>
                    <Label text="Demandes à traiter" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                
                <!-- Acceptées -->
                <VBox spacing="12" alignment="TOP_LEFT" GridPane.columnIndex="1"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region style="-fx-background-color: #d1fae5; -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48;"/>
                        <VBox spacing="4">
                            <Label text="Acceptées" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 500;"/>
                            <Label fx:id="acceptedCountLabel" text="1" 
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10b981;">
                                <font><Font name="System Bold" size="28"/></font>
                            </Label>
                        </VBox>
                    </HBox>
                    <Label text="Sessions à planifier" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                
                <!-- Sessions aujourd'hui -->
                <VBox spacing="12" alignment="TOP_LEFT" GridPane.columnIndex="2"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region style="-fx-background-color: #ddd6fe; -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48;"/>
                        <VBox spacing="4">
                            <Label text="Sessions aujourd'hui" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 500;"/>
                            <Label fx:id="todaySessionsLabel" text="0" 
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;">
                                <font><Font name="System Bold" size="28"/></font>
                            </Label>
                        </VBox>
                    </HBox>
                    <Label text="Rendez-vous du jour" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                
                <!-- Taux de conversion -->
                <VBox spacing="12" alignment="TOP_LEFT" GridPane.columnIndex="3"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region style="-fx-background-color: #fecaca; -fx-background-radius: 12; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48;"/>
                        <VBox spacing="4">
                            <Label text="Taux conversion" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 500;"/>
                            <Label fx:id="conversionRateLabel" text="0%" 
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ef4444;">
                                <font><Font name="System Bold" size="28"/></font>
                            </Label>
                        </VBox>
                    </HBox>
                    <Label text="Demandes acceptées" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </GridPane>
            
            <!-- Carte principale avec filtres et tableau -->
            <VBox spacing="24" 
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                <padding>
                    <Insets top="28" right="28" bottom="28" left="28"/>
                </padding>
                
                <!-- Barre de filtres améliorée -->
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Rechercher" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                        <TextField fx:id="searchField" promptText="Nom, email, message..."
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14px;"/>
                    </VBox>
                    
                    <VBox spacing="6">
                        <Label text="Statut" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                        <ComboBox fx:id="statusFilterCombo" promptText="Tous" prefWidth="160"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;"/>
                    </VBox>
                    
                    <VBox spacing="6">
                        <Label text="Priorité" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                        <ComboBox fx:id="priorityFilterCombo" promptText="Toutes" prefWidth="140"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;"/>
                    </VBox>
                    
                    <VBox spacing="6">
                        <Label text="Période" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                        <HBox spacing="8">
                            <DatePicker fx:id="dateFromPicker" promptText="De" prefWidth="140"
                                        style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            <DatePicker fx:id="dateToPicker" promptText="À" prefWidth="140"
                                        style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="6" alignment="BOTTOM_LEFT">
                        <Label text=" " style="-fx-font-size: 12px;"/>
                        <HBox spacing="8">
                            <Button fx:id="applyFiltersBtn" text="Appliquer" 
                                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 10; -fx-padding: 12 24 12 24; -fx-cursor: hand;"/>
                            <Button fx:id="refreshBtn" text="↻" 
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </HBox>
                
                <Separator style="-fx-background-color: #e2e8f0;"/>
                
                <!-- TableView moderne -->
                <TableView fx:id="requestsTable" 
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60" minWidth="60" maxWidth="80"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="userColumn" text="Client" prefWidth="180" minWidth="150"/>
                        <TableColumn fx:id="messageColumn" text="Message" prefWidth="280" minWidth="200"/>
                        <TableColumn fx:id="priorityColumn" text="Priorité" prefWidth="100" minWidth="80"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120" minWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="140" minWidth="120"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="280" minWidth="240"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Pagination -->
                <HBox spacing="12" alignment="CENTER">
                    <Label fx:id="paginationLabel" text="Affichage de 0 demandes" 
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                </HBox>
                
            </VBox>
            
        </VBox>
    </VBox>
</ScrollPane>
