<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.coach.MesSessionsController"
      spacing="20" style="-fx-background-color: #f5f7fb;">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Mes demandes" onAction="#goToMesDemandes"
                style="-fx-background-color: transparent; -fx-text-fill: #6c5ce7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Label text="Mes sessions"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3436;">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>
    </HBox>

    <AnchorPane VBox.vgrow="ALWAYS"
                style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
        <children>
            <VBox spacing="16" AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="selectionLabel" text="Aucune session sélectionnée"
                               style="-fx-font-size: 13px; -fx-text-fill: #636e72;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Actualiser" onAction="#refreshSessions"
                                style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="tableSessions" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="userColumn" text="User" prefWidth="180"/>
                            <TableColumn fx:id="dateColumn" text="Date" prefWidth="140"/>
                            <TableColumn fx:id="timeColumn" text="Time" prefWidth="100"/>
                            <TableColumn fx:id="durationColumn" text="Duration" prefWidth="100"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER" spacing="14">
                        <Button text="Modifier" onAction="#handleUpdate"
                                style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 26 10 26; -fx-cursor: hand;"/>
                        <Button text="Supprimer" onAction="#handleDelete"
                                style="-fx-background-color: #d63031; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 26 10 26; -fx-cursor: hand;"/>
                    </HBox>
                </children>
            </VBox>
        </children>
    </AnchorPane>
</VBox>
