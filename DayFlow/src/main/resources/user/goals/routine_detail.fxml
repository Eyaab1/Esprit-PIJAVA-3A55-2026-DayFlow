<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rd-root" stylesheets="@routine_detail.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.goals.RoutineDetailController">
   <content>
      <VBox spacing="0" styleClass="rd-inner">
         <children>
            <Hyperlink fx:id="backLink" styleClass="rd-back" text="← Retour aux routines" />

            <VBox spacing="12" styleClass="rd-header-card">
               <children>
                  <HBox alignment="TOP_LEFT" spacing="12">
                     <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="routineTitleLabel" styleClass="rd-title" text="Titre" wrapText="true" />
                              <Label fx:id="routineDescLabel" styleClass="rd-desc" text="Description" wrapText="true" />
                              <Label fx:id="visibilityBadge" styleClass="rd-badge-private" text="PRIVATE" />
                           </children>
                        </VBox>
                        <HBox alignment="TOP_RIGHT" spacing="10">
                           <children>
                              <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEditRoutine" styleClass="btn-rd-edit" text="Modifier" />
                              <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDeleteRoutine" styleClass="btn-rd-delete" text="🗑 Supprimer" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20" left="22" right="22" top="20" />
               </padding>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="rd-act-head">
               <children>
                  <Label fx:id="activitiesCountLabel" styleClass="rd-act-title" text="Activités (0)" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="newActivityBtn" mnemonicParsing="false" onAction="#onNewActivity" styleClass="btn-rd-new-act" text="＋ Nouvelle Activité" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="24" styleClass="rd-filters">
               <children>
                  <VBox spacing="4">
                     <children>
                        <Label styleClass="rd-filter-lbl" text="Trier par :" />
                        <ComboBox fx:id="sortCombo" prefWidth="220" styleClass="rd-filter-combo" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox spacing="4">
                     <children>
                        <Label styleClass="rd-filter-lbl" text="Filtrer par statut :" />
                        <ComboBox fx:id="statusFilterCombo" prefWidth="160" styleClass="rd-filter-combo" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox fx:id="activitiesEmptyBox" alignment="CENTER" spacing="16" styleClass="rd-empty">
               <children>
                  <Label styleClass="rd-empty-icon" text="✅" />
                  <Label styleClass="rd-empty-title" text="Aucune activité" />
                  <Label styleClass="rd-empty-sub" text="Créez votre première activité pour cette routine" />
                  <Button mnemonicParsing="false" onAction="#onNewActivity" styleClass="btn-rd-empty-cta" text="＋ Créer une activité" />
               </children>
               <padding>
                  <Insets bottom="40" left="24" right="24" top="32" />
               </padding>
            </VBox>

            <VBox fx:id="activitiesListBox" spacing="10" styleClass="rd-act-list">
               <padding>
                  <Insets bottom="32" left="4" right="4" top="8" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="24" left="28" right="28" top="16" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
