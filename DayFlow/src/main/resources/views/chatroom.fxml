<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ChatroomController"
      stylesheets="@/styles/style.css"
      styleClass="root"
      prefWidth="750" prefHeight="560">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <!-- HEADER -->
    <Label text="💬 Gestion des Chatrooms" styleClass="title"/>

    <!-- FORM CARD -->
    <VBox spacing="15" styleClass="card">
        <GridPane hgap="15" vgap="12">
            <Label text="Goal ID :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="goalIdField" promptText="ex: 1" prefWidth="180"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="État :" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="stateBox" prefWidth="180"
                      GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="ID (modif/suppr) :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="updateIdField" promptText="ID existant" prefWidth="180"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- BUTTONS -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="➕ Ajouter"    onAction="#addChatroom"    styleClass="button,btn-add"/>
        <Button text="✏️ Modifier"   onAction="#updateChatroom" styleClass="button,btn-edit"/>
        <Button text="🗑 Supprimer"  onAction="#deleteChatroom" styleClass="button,btn-delete"/>
        <Button text="🔄 Actualiser" onAction="#loadAll"        styleClass="button,btn-refresh"/>
    </HBox>

    <Label fx:id="statusLabel" text=""/>

    <!-- TABLE CARD -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableView" prefHeight="260" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"        text="ID"       prefWidth="60"/>
                <TableColumn fx:id="colGoalId"    text="Goal ID"  prefWidth="120"/>
                <TableColumn fx:id="colState"     text="État"     prefWidth="130"/>
                <TableColumn fx:id="colCreatedAt" text="Créé le"  prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
