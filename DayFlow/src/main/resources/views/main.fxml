<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="30"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.MainController"
      stylesheets="@/styles/style.css"
      styleClass="gradient-bg"
      prefWidth="440" prefHeight="380">

    <!-- App name -->
    <Label text="DayFlow"
           style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: white;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0, 0, 2);"/>
    <Label text="Choisissez un module"
           style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75);"/>

    <!-- Nav buttons -->
    <VBox spacing="14" alignment="CENTER">
        <Button text="💬   Chatrooms"      onAction="#openChatroom"          prefWidth="260" styleClass="btn-nav"/>
        <Button text="✉️   Messages"       onAction="#openMessage"           prefWidth="260" styleClass="btn-nav"/>
        <Button text="🎯   Participations" onAction="#openGoalParticipation" prefWidth="260" styleClass="btn-nav"/>
    </VBox>

</VBox>
