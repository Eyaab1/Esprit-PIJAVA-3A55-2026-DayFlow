<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.GoalParticipationController"
      stylesheets="@/styles/style.css"
      styleClass="root"
      prefWidth="780" prefHeight="580">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <!-- HEADER -->
    <Label text="🎯 Participation aux Goals" styleClass="title"/>

    <!-- FORM CARD -->
    <VBox spacing="15" styleClass="card">
        <GridPane hgap="15" vgap="12">
            <Label text="User ID :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="userIdField" promptText="ex: 1" prefWidth="170"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Goal ID :" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="goalIdField" promptText="ex: 1" prefWidth="170"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Rôle :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="roleBox" prefWidth="170"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Statut :" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <ComboBox fx:id="statusBox" prefWidth="170"
                      GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="ID (modif/suppr) :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="updateIdField" promptText="ID existant" prefWidth="170"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- BUTTONS -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="➕ Ajouter"    onAction="#addParticipation"    styleClass="button,btn-add"/>
        <Button text="✏️ Modifier"   onAction="#updateParticipation" styleClass="button,btn-edit"/>
        <Button text="🗑 Supprimer"  onAction="#deleteParticipation" styleClass="button,btn-delete"/>
        <Button text="🔄 Actualiser" onAction="#loadAll"             styleClass="button,btn-refresh"/>
    </HBox>

    <Label fx:id="statusLabel" text=""/>

    <!-- TABLE CARD -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableView" prefHeight="260" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"        text="ID"       prefWidth="60"/>
                <TableColumn fx:id="colUserId"    text="User ID"  prefWidth="90"/>
                <TableColumn fx:id="colGoalId"    text="Goal ID"  prefWidth="90"/>
                <TableColumn fx:id="colRole"      text="Rôle"     prefWidth="120"/>
                <TableColumn fx:id="colStatus"    text="Statut"   prefWidth="120"/>
                <TableColumn fx:id="colCreatedAt" text="Créé le"  prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
