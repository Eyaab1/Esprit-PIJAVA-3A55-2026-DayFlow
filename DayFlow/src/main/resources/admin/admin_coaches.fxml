<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminCoachesController" styleClass="admin-root" stylesheets="@admin.css">
    <fx:define>
        <ToggleGroup fx:id="viewModeGroup"/>
    </fx:define>
    <content>
        <VBox styleClass="admin-content" spacing="20">
            <VBox spacing="6">
                <Label styleClass="admin-page-title" text="Coachs"/>
                <Label styleClass="admin-page-sub" text="Comptes coachs, sessions et demandes"/>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher par nom, e-mail ou spécialité…"
                           styleClass="admin-filter-field" HBox.hgrow="ALWAYS" maxWidth="520"
                           onAction="#onSearch"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="gridToggleBtn" text="Grille" selected="true" toggleGroup="$viewModeGroup" onAction="#onViewModeChanged"/>
                <ToggleButton fx:id="listToggleBtn" text="Liste" toggleGroup="$viewModeGroup" onAction="#onViewModeChanged"/>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS" minHeight="400">
                <FlowPane fx:id="coachesFlowPane" hgap="16" vgap="16"/>
                <VBox fx:id="coachesListPane" visible="false" managed="false" spacing="0"/>
            </StackPane>
        </VBox>
    </content>
</ScrollPane>
