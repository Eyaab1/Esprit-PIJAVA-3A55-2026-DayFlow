<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminModerationLogsController" styleClass="admin-root" stylesheets="@admin.css">
    <content>
        <VBox styleClass="admin-content" spacing="18">
            <VBox spacing="6">
                <Label styleClass="admin-page-title" text="Moderation Logs"/>
                <Label styleClass="admin-page-sub" text="Incidents de modération triés du plus récent au plus ancien"/>
            </VBox>
            
            <!-- Filter toolbar -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 8 0;">
                <Label text="Filtrer par statut:" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="200" style="-fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <VBox styleClass="admin-posts-table-wrap" spacing="0">
                <HBox spacing="12" styleClass="admin-posts-header" alignment="CENTER_LEFT">
                    <Label minWidth="160" prefWidth="160" maxWidth="160" text="Timestamp" style="-fx-font-weight:bold;"/>
                    <Label minWidth="180" prefWidth="180" maxWidth="180" text="User Email" style="-fx-font-weight:bold;"/>
                    <Label minWidth="120" prefWidth="120" maxWidth="120" text="Entity Type" style="-fx-font-weight:bold;"/>
                    <Label minWidth="250" prefWidth="250" maxWidth="250" text="Content Preview" style="-fx-font-weight:bold;"/>
                    <Label minWidth="140" prefWidth="140" maxWidth="140" text="Highest Attribute" style="-fx-font-weight:bold;"/>
                    <Label minWidth="100" prefWidth="100" maxWidth="100" text="Highest Score" style="-fx-font-weight:bold;"/>
                    <Label minWidth="120" prefWidth="120" maxWidth="120" text="Statut" style="-fx-font-weight:bold;"/>
                    <Label minWidth="80" prefWidth="80" maxWidth="80" text="Actions" style="-fx-font-weight:bold;"/>
                </HBox>
                <ScrollPane fx:id="moderationRowsScrollPane" fitToWidth="true" maxHeight="720" style="-fx-background-color:transparent;">
                    <VBox fx:id="moderationRowsBox" spacing="0"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
