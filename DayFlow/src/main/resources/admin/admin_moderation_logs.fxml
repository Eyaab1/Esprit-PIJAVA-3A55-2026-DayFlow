<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminModerationLogsController" styleClass="admin-root" stylesheets="@admin.css">
    <content>
        <VBox styleClass="admin-content" spacing="14">
            <Label styleClass="admin-page-title" text="Moderation Logs"/>
            <Label styleClass="admin-page-sub"
                   text="Incidents de modération triés du plus récent au plus ancien. Gérez les warnings et bans."/>
            <VBox styleClass="admin-card" spacing="8">
                <VBox fx:id="moderationLogsBox" spacing="0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
