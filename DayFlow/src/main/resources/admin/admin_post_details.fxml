<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminPostDetailsController" styleClass="admin-root" stylesheets="@admin_post_details.css">
    <content>
        <VBox styleClass="admin-content" spacing="20">
            <!-- Top Navigation Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="details-top-bar">
                <Button fx:id="backBtn" text="← Retour" onAction="#onBack" styleClass="details-back-btn"/>
                <Label fx:id="pageTitle" styleClass="details-page-title" text="Détail du post"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Supprimer" styleClass="details-action-btn, action-delete" onAction="#onDeletePost"/>
            </HBox>

            <!-- Main Content: Post Details (Left) + Analytics (Right) -->
            <HBox spacing="20" alignment="TOP_LEFT">
                <!-- LEFT: Post Details Card -->
                <VBox styleClass="details-header-card" spacing="16" HBox.hgrow="ALWAYS">
                    <!-- Title -->
                    <Label fx:id="postTitleLabel" styleClass="details-post-title" text="Titre du post" wrapText="true"/>
                    
                    <!-- Author Info Row -->
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label fx:id="authorAvatar" styleClass="details-avatar" text="AB"/>
                        <VBox spacing="2">
                            <Label fx:id="authorNameLabel" styleClass="details-author-name" text="Auteur"/>
                            <Label fx:id="authorEmailLabel" styleClass="details-author-email" text="email@example.com"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="2" alignment="CENTER_RIGHT">
                            <Label fx:id="publishDateLabel" styleClass="details-publish-date" text="28 avril 2026"/>
                            <Label fx:id="publishTimeLabel" styleClass="details-publish-time" text="14:30"/>
                        </VBox>
                    </HBox>

                    <!-- Status and Tags Row -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="postStatusLabel" styleClass="details-status-badge" text="Publié"/>
                        <Label fx:id="postTagsLabel" styleClass="details-tags" text="motivation, bien-être"/>
                    </HBox>

                    <!-- Content Box -->
                    <VBox styleClass="details-content-box" spacing="8">
                        <Label text="Contenu" styleClass="details-section-label"/>
                        <Label fx:id="postContentLabel" wrapText="true" styleClass="details-content-text" text="Contenu du post..."/>
                    </VBox>
                </VBox>

                <!-- RIGHT: Analytics Section -->
                <VBox spacing="14" styleClass="details-analytics-sidebar">
                    <Label text="Analytics" styleClass="details-sidebar-title"/>
                    
                    <!-- KPI Cards Grid (Compact) -->
                    <VBox spacing="10">
                        <!-- Views Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-views" text="👁"/>
                            <VBox spacing="2">
                                <Label text="Vues" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="viewsLabel" styleClass="details-kpi-value-compact" text="0"/>
                            </VBox>
                        </HBox>

                        <!-- Clicks Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-clicks" text="🖱"/>
                            <VBox spacing="2">
                                <Label text="Clics" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="clicksLabel" styleClass="details-kpi-value-compact" text="0"/>
                            </VBox>
                        </HBox>

                        <!-- Likes Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-likes" text="❤"/>
                            <VBox spacing="2">
                                <Label text="Likes" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="likesLabel" styleClass="details-kpi-value-compact" text="0"/>
                            </VBox>
                        </HBox>

                        <!-- Comments Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-comments" text="💬"/>
                            <VBox spacing="2">
                                <Label text="Commentaires" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="commentsCountLabel" styleClass="details-kpi-value-compact" text="0"/>
                            </VBox>
                        </HBox>

                        <!-- CTR Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-ctr" text="📊"/>
                            <VBox spacing="2">
                                <Label text="CTR" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="ctrLabel" styleClass="details-kpi-value-compact" text="0%"/>
                            </VBox>
                        </HBox>

                        <!-- Trend Card -->
                        <HBox styleClass="details-kpi-card-compact" spacing="12" alignment="CENTER_LEFT">
                            <Label styleClass="details-kpi-icon-compact, kpi-icon-trend" text="📈"/>
                            <VBox spacing="2">
                                <Label text="Tendance" styleClass="details-kpi-label-compact"/>
                                <Label fx:id="trendLabel" styleClass="details-kpi-value-compact" text="—"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Chart Card (Compact) -->
                    <VBox styleClass="details-chart-card-compact" spacing="10">
                        <Label text="Graphique" styleClass="details-chart-title-compact"/>
                        <BarChart fx:id="analyticsChart" prefHeight="180" prefWidth="280" categoryGap="20" barGap="8" styleClass="details-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" styleClass="chart-axis"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT" styleClass="chart-axis"/>
                            </yAxis>
                        </BarChart>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Comments Section -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Commentaires" styleClass="details-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="commentsSortCombo" styleClass="details-sort-combo" prefWidth="160" onAction="#onCommentsSortChange"/>
                </HBox>
                
                <VBox styleClass="details-comments-card" spacing="12">
                    <VBox fx:id="commentsBox" spacing="12"/>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
