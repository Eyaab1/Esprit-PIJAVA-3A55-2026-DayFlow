<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminUsersController" styleClass="admin-root" stylesheets="@admin.css">
    <fx:define>
        <ToggleGroup fx:id="viewModeGroup"/>
    </fx:define>
    <content>
        <VBox styleClass="admin-content" spacing="20">
            <VBox spacing="6">
                <Label styleClass="admin-page-title" text="Utilisateurs"/>
                <Label styleClass="admin-page-sub" text="Parcourir les comptes utilisateurs et coachs"/>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="nameFilterField" promptText="Rechercher par nom" styleClass="admin-filter-field"/>
                <TextField fx:id="emailFilterField" promptText="Rechercher par e-mail" styleClass="admin-filter-field"/>
                <Button text="Filtrer" styleClass="admin-filter-btn" onAction="#onFilter"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="gridToggleBtn" text="Grille" selected="true" toggleGroup="$viewModeGroup" onAction="#onViewModeChanged"/>
                <ToggleButton fx:id="listToggleBtn" text="Liste" toggleGroup="$viewModeGroup" onAction="#onViewModeChanged"/>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS" minHeight="400">
                <FlowPane fx:id="usersFlowPane" hgap="16" vgap="16"/>
                <VBox fx:id="usersListPane" visible="false" managed="false" spacing="0"/>
            </StackPane>
        </VBox>
    </content>
</ScrollPane>
