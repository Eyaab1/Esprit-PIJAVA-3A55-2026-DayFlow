<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AdminPostsController" styleClass="admin-root" stylesheets="@admin.css">
    <content>
        <VBox styleClass="admin-content" spacing="18">
            <VBox spacing="6">
                <Label styleClass="admin-page-title" text="Toutes les publications"/>
                <Label styleClass="admin-page-sub" text="Modérer et filtrer les posts de la communauté"/>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="admin-filter-bar">
                <TextField fx:id="authorNameField" promptText="Rechercher par nom…" styleClass="admin-filter-field" prefWidth="200"
                           onAction="#onFilter"/>
                <TextField fx:id="authorEmailField" promptText="Rechercher par e-mail…" styleClass="admin-filter-field" prefWidth="200"
                           onAction="#onFilter"/>
                <ComboBox fx:id="tagCombo" promptText="Tag" prefWidth="160"/>
                <ComboBox fx:id="trendCombo" prefWidth="150"/>
                <ComboBox fx:id="sortCombo" prefWidth="140"/>
                <Button text="Filtrer" styleClass="admin-filter-btn" onAction="#onFilter"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <VBox styleClass="admin-posts-table-wrap" spacing="0">
                <HBox spacing="12" styleClass="admin-posts-header" alignment="CENTER_LEFT">
                    <Label minWidth="360" prefWidth="360" maxWidth="360" text="Titre" style="-fx-font-weight:bold;"/>
                    <Label minWidth="170" prefWidth="170" maxWidth="170" text="Auteur" style="-fx-font-weight:bold;"/>
                    <Label minWidth="110" prefWidth="110" maxWidth="110" text="Publié le" style="-fx-font-weight:bold;"/>
                    <Label minWidth="60" prefWidth="60" maxWidth="60" text="Vues" style="-fx-font-weight:bold;"/>
                    <Label minWidth="60" prefWidth="60" maxWidth="60" text="Clics" style="-fx-font-weight:bold;"/>
                    <Label minWidth="70" prefWidth="70" maxWidth="70" text="CTR" style="-fx-font-weight:bold;"/>
                    <Label minWidth="120" prefWidth="120" maxWidth="120" text="Tendance" style="-fx-font-weight:bold;"/>
                    <Label minWidth="95" prefWidth="95" maxWidth="95" text="Statut" style="-fx-font-weight:bold;"/>
                    <Label minWidth="44" prefWidth="44" maxWidth="44" text="" style="-fx-font-weight:bold;"/>
                </HBox>
                <ScrollPane fx:id="postsRowsScrollPane" fitToWidth="true" maxHeight="720" style="-fx-background-color:transparent;">
                    <VBox fx:id="postsRowsBox" spacing="0"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
