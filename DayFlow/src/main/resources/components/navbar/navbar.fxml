<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.components.NavbarController"
      styleClass="navbar-root"
      stylesheets="@navbar.css"
      minHeight="44"
      spacing="6" alignment="CENTER_LEFT">
    <padding>
        <Insets top="8" right="16" bottom="8" left="16"/>
    </padding>

    <Label text="DayFlow" styleClass="navbar-brand"/>
    <Separator orientation="VERTICAL" prefHeight="22" styleClass="navbar-brand-sep"/>

    <Hyperlink text="Accueil" onAction="#onAccueil"/>
    <Hyperlink text="Objectifs" onAction="#onObjectifs"/>
    <Hyperlink text="Communauté" onAction="#onCommunity"/>
    <Hyperlink text="Posts" onAction="#onPosts"/>
    <Hyperlink text="Mes demandes" onAction="#handleMesDemandes"/>
    <Hyperlink fx:id="manageSessionsLink" text="Mes sessions" onAction="#onGererSessions"/>
    <Hyperlink text="Messages" onAction="#onMessages"/>
    <Hyperlink text="Calendrier" onAction="#onCalendrier"/>
    <Hyperlink text="Favoris" onAction="#onFavoris"/>
    <Region styleClass="navbar-spacer" HBox.hgrow="ALWAYS"/>

    <StackPane fx:id="notificationsContainer" styleClass="navbar-notif-wrap">
        <Button fx:id="notificationsBellButton" text="🔔" onAction="#onNotifications" styleClass="navbar-bell-btn" />
        <Label fx:id="notificationsBadgeLabel" text="0" styleClass="navbar-notif-badge" visible="false" managed="false"/>
    </StackPane>

    <Hyperlink fx:id="avatarLink" text="?" styleClass="navbar-avatar" alignment="CENTER" onAction="#onProfile" />
    <Separator orientation="VERTICAL" prefHeight="24"/>
    <Hyperlink text="Déconnexion" onAction="#onLogout"/>
</HBox>
